{
  "name": "nil33",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:qbdna": "cd apps/qbdna && npm run dev",
    "dev:nil33": "cd apps/nil33 && npm run dev",
    "dev:uc": "cd apps/under-center && npm run dev",
    "build:qbdna": "cd apps/qbdna && npm run build",
    "build:nil33": "cd apps/nil33 && npm run build",
    "build:uc": "cd apps/under-center && npm run build",
    "dev:nil33-rails": "cd apps/nil33-rails && npm run dev",
    "build:nil33-rails": "cd apps/nil33-rails && npm run build",
    "up:nil33": "docker compose -f docker-compose.nil33.yml up -d",
    "down:nil33": "docker compose -f docker-compose.nil33.yml down"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
